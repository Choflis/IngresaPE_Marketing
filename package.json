{
  "name": "ingresape-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx src/server/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "runway:check": "tsx scripts/runway-check.ts",
    "runway:avatar": "tsx scripts/runway-avatar.ts",
    "runway:smoke": "tsx scripts/runway-smoke.ts",
    "test:db": "tsx scripts/test-db.ts",
    "account:reset": "tsx scripts/reset-account.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@runwayml/sdk": "4.24.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.9",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
